{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "saveshipcost.com" }],
      "destination": "https://www.saveshipcost.com/$1",
      "permanent": true
    },
    { "source": "/",                "destination": "/en",                "permanent": true },
    { "source": "/air-freight",     "destination": "/en/air-freight",    "permanent": true },
    { "source": "/sea-freight",     "destination": "/en/sea-freight",    "permanent": true },
    { "source": "/ottawa",          "destination": "/en/ottawa",         "permanent": true },
    { "source": "/faq",             "destination": "/en/faq",            "permanent": true },
    { "source": "/forum",           "destination": "/en/forum",          "permanent": true },
    { "source": "/contact",         "destination": "/en/contact",        "permanent": true },
    { "source": "/privacy-policy",  "destination": "/en/privacy-policy", "permanent": true },
    { "source": "/terms-of-use",    "destination": "/en/terms-of-use",   "permanent": true },
    { "source": "/disclaimer",      "destination": "/en/disclaimer",     "permanent": true },
    { "source": "/cookie-policy",   "destination": "/en/cookie-policy",  "permanent": true },
    { "source": "/login",           "destination": "/en/login",          "permanent": true },
    { "source": "/register",        "destination": "/en/register",       "permanent": true },
    { "source": "/forgot-password", "destination": "/en/forgot-password", "permanent": true },
    { "source": "/reset-password",  "destination": "/en/reset-password", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
